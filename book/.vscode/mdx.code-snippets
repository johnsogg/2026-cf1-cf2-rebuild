{
  "ask block": {
    "scope": "mdx",
    "prefix": "ask",
    "body": [
      "<Ask id=\"${1:ask-id}\" mode=\"${2|untracked,interacted,graded|}\" title=\"${3:Title}\">",
      "",
      "$0",
      "",
      "</Ask>"
    ],
    "description": "Insert an <Ask> wrapper with id/mode/title, ready for content"
  },
  "p5exercise block": {
    "scope": "mdx",
    "prefix": "p5exercise",
    "body": [
      "```p5exercise autorun size=\"${1|small,medium,large|}\"",
      "function setup() {",
      "  createCanvas(150, 150)",
      "}",
      "",
      "function draw() {",
      "  background(\"black\")",
      "}",
      "```",
      "$0"
    ],
    "description": "Insert a p5exercise code fence with basic setup/draw (wrap in <Ask> for id/title)"
  },
  "p5sketch block": {
    "scope": "mdx",
    "prefix": "p5sketch",
    "body": [
      "```p5sketch autoplay width=${1:150} height=${2:150}",
      "function setup() {",
      "  createCanvas(${1:150}, ${2:150})",
      "}",
      "",
      "function draw() {",
      "  background(\"black\")",
      "}",
      "```",
      "$0"
    ],
    "description": "Insert a p5sketch code fence with basic setup/draw"
  },
  "solution block": {
    "scope": "mdx",
    "prefix": "solution",
    "body": [
      "<Solution id=\"${1:ask-id}\">",
      "",
      "```p5exercise autorun size=\"${2|small,medium,large|}\"",
      "function setup() {",
      "  createCanvas(150, 150)",
      "}",
      "",
      "function draw() {",
      "  background(\"black\")",
      "}",
      "```",
      "",
      "</Solution>",
      "$0"
    ],
    "description": "Insert a <Solution> block reusing the id of the <Ask> it pairs with"
  },
  "jsconsole block": {
    "scope": "mdx",
    "prefix": "jsconsole",
    "body": [
      "```jsconsole size=\"${1|small,medium,large|}\"",
      "console.log(\"Hello, World!\")",
      "```",
      "$0"
    ],
    "description": "Insert a jsconsole code fence (wrap in <Ask> for id/title)"
  }
}
